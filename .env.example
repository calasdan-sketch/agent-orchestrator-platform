# ---- Server ----
PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# ---- Datastore ----
# Path to the SQLite database file (jobs table).
DATABASE_PATH=./data/agents.sqlite

# ---- LLM provider (used by every agent) ----
ANTHROPIC_API_KEY=
# Model to use for generation.
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Max tokens per completion.
CLAUDE_MAX_TOKENS=1024
# "anthropic" (default, direct API + prompt caching) or "openrouter".
CLAUDE_PROVIDER=anthropic
# Required when CLAUDE_PROVIDER=openrouter. Create a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug to use via OpenRouter, e.g. anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
